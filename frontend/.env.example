# Base URL of the FastAPI backend.
#
# Leave this empty during development: the Vite dev server proxies "/api"
# requests to http://127.0.0.1:8000, so the app can use relative paths.
#
# Set it (for example to http://127.0.0.1:8000) when serving the built app
# from a different origin than the API.
VITE_API_BASE_URL=
